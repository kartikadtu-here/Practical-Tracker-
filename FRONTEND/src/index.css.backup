@import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap");

:root {
  font-family:"DM Sans",sans-serif; color:#20241f; background:#f3f4ef;
  font-synthesis:none; text-rendering:optimizeLegibility;
  --bg:#f3f4ef; --surface:#fffefa; --surface2:#eef0e9; --border:#dfe2d9;
  --text:#20241f; --muted:#7b8177; --soft:#a0a59c; --accent:#6e7d63;
  --accent2:#536149; --danger:#b85d55; --shadow:0 18px 50px rgba(35,40,32,.07);
}
:root[data-theme="dark"] {
  --bg:#10130f; --surface:#181c16; --surface2:#20261d; --border:#30372c;
  --text:#edf1e8; --muted:#9da59a; --soft:#6f786b; --accent:#a5b99a;
  --accent2:#c3d6b7; --shadow:0 18px 50px rgba(0,0,0,.28);
}
*{box-sizing:border-box} html,body,#root{margin:0;min-height:100%;width:100%} body{background:var(--bg);color:var(--text)}
button,input,select,textarea{font:inherit}button{cursor:pointer}button:disabled{opacity:.45;cursor:not-allowed}
.app{min-height:100vh;background:radial-gradient(circle at 80% 10%,rgba(120,140,105,.09),transparent 28%),var(--bg)}
.sidebar{position:fixed;left:0;top:0;bottom:0;width:216px;border-right:1px solid var(--border);background:color-mix(in srgb,var(--surface) 92%,transparent);padding:24px 14px;display:flex;flex-direction:column;z-index:20}
.brand{display:flex;align-items:center;gap:10px;padding:0 8px 30px}.brand-mark{width:34px;height:34px;border-radius:10px;background:var(--accent);color:white;display:grid;place-items:center;font-weight:800}.brand b{display:block;font-size:13px}.brand span{display:block;font-size:10px;color:var(--soft);margin-top:2px}.side-label,.mini{font:500 8px "DM Mono",monospace;letter-spacing:.13em;color:var(--soft)}.side-label{padding:0 10px 8px}nav{display:grid;gap:3px}.nav{width:100%;display:flex;align-items:center;gap:11px;border:0;background:transparent;color:var(--muted);padding:10px;border-radius:9px;text-align:left;font-size:11px}.nav:hover,.nav.active{background:var(--surface2);color:var(--text)}.nav.active{font-weight:700}.side-bottom{margin-top:auto}.teacher{border-top:1px solid var(--border);padding:16px 5px 0;margin-top:10px;display:flex;align-items:center;gap:8px}.teacher>div:nth-child(2){min-width:0;flex:1}.teacher b,.teacher span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.teacher b{font-size:10px}.teacher span{font-size:8px;color:var(--soft);margin-top:2px}.teacher button{border:0;background:transparent;color:var(--soft)}
.main{margin-left:216px;min-height:100vh}.topbar{height:62px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:15;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(16px)}.searchbox{height:36px;width:370px;border:1px solid var(--border);border-radius:10px;background:var(--surface);display:flex;align-items:center;gap:8px;padding:0 10px;color:var(--soft)}.searchbox input{border:0;outline:0;background:transparent;color:var(--text);width:100%;font-size:11px}.searchbox kbd{font-size:8px;border:1px solid var(--border);padding:3px 5px;border-radius:5px;color:var(--soft)}.top-actions{display:flex;align-items:center;gap:13px}.live{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:9px}.live i{width:6px;height:6px;border-radius:50%;background:#78926e;box-shadow:0 0 0 3px rgba(120,146,110,.12)}.avatar{width:29px;height:29px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:9px;font-weight:700}.icon-btn{width:34px;height:34px;border:1px solid var(--border);border-radius:9px;background:var(--surface);color:var(--muted);display:grid;place-items:center}.page{padding:46px 6.5% 70px;max-width:1450px;margin:auto}.hero{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:34px}.eyebrow{font:600 9px "DM Mono",monospace;letter-spacing:.12em;color:var(--muted)}.eyebrow i,.eyebrow-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--accent);margin-right:8px}.hero h1{font:800 clamp(42px,5vw,62px) Manrope,sans-serif;line-height:.95;letter-spacing:-.05em;margin:16px 0}.hero h1 em{font-style:normal;color:var(--accent)}.hero p{max-width:520px;color:var(--muted);font-size:13px;line-height:1.6}.hero-meta{font-size:8px;color:var(--soft);text-align:right;line-height:1.8}.hero-meta strong{display:block;color:var(--muted);font-size:10px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}.stat,.card{border:1px solid var(--border);background:color-mix(in srgb,var(--surface) 94%,transparent);border-radius:15px;box-shadow:var(--shadow)}.stat{min-height:156px;padding:17px;position:relative}.stat-icon,.quick-icon,.upload-icon{width:31px;height:31px;border-radius:9px;background:var(--surface2);color:var(--accent);display:grid;place-items:center}.stat-arrow{position:absolute;right:17px;top:19px;color:var(--soft)}.stat strong{display:block;font:700 29px Manrope;margin-top:20px}.stat b{display:block;font-size:10px}.stat small{display:block;color:var(--soft);font-size:9px;margin-top:11px}.grid2{display:grid;grid-template-columns:1.5fr .8fr;gap:16px}.card{padding:21px}.section-top,.sql-head,.page-heading{display:flex;justify-content:space-between;align-items:flex-start}.section-top h2,.sql-head h2,.page-heading h1,.card h2{margin:6px 0;font-family:Manrope;letter-spacing:-.03em}.section-top h2,.sql-head h2,.card h2{font-size:17px}.section-top small{color:var(--soft);font-size:9px}.ghost,.secondary{border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:8px;padding:8px 10px;font-size:9px}.primary{border:0;background:var(--accent);color:white;border-radius:8px;padding:9px 12px;font-size:10px;font-weight:700;display:inline-flex;align-items:center;gap:7px}.primary:hover{background:var(--accent2)}.wide{width:100%;justify-content:center;margin-top:6px}.progress-head,.progress-foot{display:flex;justify-content:space-between;font-size:9px;margin-top:26px}.progress-head span{color:#aa8e5c}.progress{height:7px;border-radius:10px;background:var(--surface2);margin-top:9px;overflow:hidden}.progress i{display:block;height:100%;border-radius:inherit;background:var(--accent)}.progress-foot{margin-top:7px;color:var(--soft)}.student-preview{margin-top:18px;border-top:1px solid var(--border)}.row,.submission-row,.system-row,.practical-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border)}.row:last-child{border-bottom:0}.initial{width:28px;height:28px;border-radius:8px;background:var(--surface2);display:grid;place-items:center;font:500 8px "DM Mono";color:var(--muted);flex:none}.row div,.person-copy{min-width:0;flex:1}.row b,.person-copy b{display:block;font-size:9px}.row small,.person-copy small{display:block;color:var(--soft);font-size:8px;margin-top:2px}.ok{color:var(--accent);font-size:12px}.wait{color:#ad8e5a;font-size:9px}.quick{margin-top:13px}.quick-row{width:100%;border:0;border-top:1px solid var(--border);background:transparent;color:var(--text);display:flex;align-items:center;gap:10px;padding:13px 0;text-align:left}.quick-row span:nth-child(2){flex:1}.quick-row b,.quick-row small{display:block}.quick-row b{font-size:10px}.quick-row small{color:var(--soft);font-size:8px;margin-top:2px}.quick-row>svg{color:var(--soft)}.muted-box,.empty{padding:24px;color:var(--soft);font-size:10px;text-align:center}.toast{position:fixed;right:22px;bottom:22px;background:#222820;color:#fff;padding:11px 14px;border-radius:9px;display:flex;gap:8px;align-items:center;font-size:10px;z-index:100;box-shadow:0 14px 40px rgba(0,0,0,.2)}.subpage{max-width:1100px;margin:auto}.page-heading{margin-bottom:28px;align-items:center}.page-heading h1{font-size:36px}.toolbar{display:flex;align-items:center;gap:8px;margin-bottom:12px}.table-search{height:38px;flex:1;max-width:360px;border:1px solid var(--border);border-radius:9px;background:var(--surface);display:flex;align-items:center;padding:0 10px;gap:7px;color:var(--soft)}.table-search input,.toolbar select{border:0;outline:0;background:transparent;color:var(--text);font-size:10px;width:100%}.toolbar select{border:1px solid var(--border);background:var(--surface);border-radius:9px;padding:10px;max-width:300px}.count{margin-left:auto;color:var(--soft);font-size:9px}.table-card{padding:0;overflow:hidden}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:13px 18px;border-bottom:1px solid var(--border);font-size:9px}th{font:500 8px "DM Mono";letter-spacing:.1em;color:var(--soft);background:var(--surface2)}td{color:var(--muted)}code{font-family:"DM Mono",monospace}.person{display:flex;align-items:center;gap:9px;color:var(--text)}.pill{display:inline-flex;padding:4px 7px;border-radius:99px;background:var(--surface2);color:var(--muted);font-size:8px}.ok-pill{color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,var(--surface))}.submission-list{padding:8px 20px}.submission-row{padding:14px 0}.submission-row.done{background:color-mix(in srgb,var(--accent) 5%,transparent)}.submission-row input{width:17px;height:17px;accent-color:var(--accent)}.status-text{font-size:9px;color:var(--soft)}.submission-row.done .status-text{color:var(--accent)}.import-grid,.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.drop{min-height:390px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;border-style:dashed}.upload-icon{width:52px;height:52px;margin-bottom:10px}.drop h2{font-size:18px}.drop p{max-width:350px;color:var(--muted);font-size:10px;line-height:1.6}.drop .primary,.drop .secondary{margin:5px}.review{min-height:390px}.ocr-row{display:grid;grid-template-columns:70px 1fr;gap:8px;padding:8px 0;border-bottom:1px solid var(--border)}.ocr-row input,.stack input,.stack textarea{width:100%;border:1px solid var(--border);background:var(--surface2);color:var(--text);border-radius:8px;padding:9px;font-size:10px;outline:none}.ocr-row span{padding:9px;color:var(--muted);font-family:"DM Mono";font-size:9px}.stack{display:grid;gap:9px;margin-top:14px}.stack textarea{min-height:90px;resize:vertical}.practical-grid{align-items:start}.practical-list{margin-top:14px}.practical-item .number{font:500 10px "DM Mono";color:var(--soft);width:25px}.practical-item div{flex:1}.practical-item b,.practical-item small{display:block}.practical-item b{font-size:10px}.practical-item small{font-size:8px;color:var(--soft);margin-top:3px}.settings-grid{grid-template-columns:1fr 1fr}.theme-options{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.theme-option{border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:15px;text-align:left;color:var(--text);display:grid;gap:7px}.theme-option svg{color:var(--accent)}.theme-option b{font-size:11px}.theme-option small{color:var(--soft);font-size:8px}.theme-option.selected{border-color:var(--accent);box-shadow:0 0 0 2px color-mix(in srgb,var(--accent) 14%,transparent)}.system-row span:nth-child(2){flex:1}.system-row b,.system-row small{display:block}.system-row b{font-size:10px}.system-row small{font-size:8px;color:var(--soft);margin-top:2px}.boot{height:100vh;display:grid;place-content:center;justify-items:center;gap:10px;background:var(--bg);color:var(--muted);font-size:11px}.spin{animation:spin 1s linear infinite}.login{min-height:100vh;display:grid;place-items:center;background:var(--bg);position:relative;overflow:hidden}.login-glow{position:absolute;width:500px;height:500px;border-radius:50%;background:rgba(120,145,105,.11);filter:blur(90px)}.login-card{width:420px;max-width:calc(100vw - 30px);position:relative;background:var(--surface);border:1px solid var(--border);border-radius:22px;padding:34px;box-shadow:var(--shadow)}.login-card .brand-mark{margin-bottom:25px}.login-card h1{font:800 39px Manrope;letter-spacing:-.05em;line-height:1;margin:12px 0}.login-card h1 span{color:var(--accent)}.login-card p{color:var(--muted);font-size:11px;line-height:1.6;margin-bottom:24px}.login-card form{display:grid;gap:12px}.login-card label{font-size:9px;color:var(--muted)}.login-card input{display:block;width:100%;margin-top:6px;border:1px solid var(--border);border-radius:9px;background:var(--surface2);color:var(--text);padding:11px;outline:none;font-size:11px}.login-card small{display:block;color:var(--soft);font-size:8px;margin-top:18px}.error{background:#f7e5e3;color:#a34f49;padding:8px;border-radius:7px;font-size:9px}.sql-lab{margin-top:16px}.sql-head p{color:var(--muted);font-size:9px}.sql-buttons{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:15px}.sql-btn{border:1px solid var(--border);background:var(--surface2);color:var(--text);border-radius:9px;padding:9px;text-align:left;display:flex;align-items:center;gap:7px;min-width:0}.sql-btn.active{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 9%,var(--surface))}.sql-btn code{background:var(--surface);padding:5px;border-radius:5px;color:var(--accent);font-size:7px}.sql-btn span{min-width:0;flex:1}.sql-btn b,.sql-btn small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sql-btn b{font-size:8px}.sql-btn small{font-size:7px;color:var(--soft);margin-top:2px}.sql-console{margin-top:10px;padding:12px;background:#242923;border-radius:10px;color:#dbe5d2}.console-top{display:flex;align-items:center;gap:7px;font:500 8px "DM Mono";color:#9cab91}.console-top b{color:#dbe5d2}.console-top em{margin-left:auto;color:#9cab91;font-style:normal}.sql-console pre{font:400 9px/1.5 "DM Mono";white-space:pre-wrap;overflow-wrap:anywhere;margin:12px 0;padding:11px;background:#171b16;border-radius:7px;color:#d9e6d0}.sql-explain span{font:500 7px "DM Mono";color:#83907d;letter-spacing:.1em}.sql-explain p{font-size:9px;color:#b9c2b2;margin:4px 0}.fake-result{border-top:1px solid #394137;margin-top:10px;padding-top:8px;display:grid;gap:4px;font:400 8px "DM Mono";color:#8e9988}.fake-result b{color:#9dbb8d}.fake-result i{color:#b9a06e;font-style:normal}.sql-console.running{box-shadow:0 0 0 1px rgba(165,185,154,.35),0 0 35px rgba(120,150,100,.13)}@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:1000px){.sidebar{width:190px}.main{margin-left:190px}.stats{grid-template-columns:1fr 1fr}.sql-buttons{grid-template-columns:1fr 1fr}.grid2,.import-grid,.settings-grid{grid-template-columns:1fr}.page{padding:34px 4%}.hero{align-items:flex-start;gap:20px;flex-direction:column}}
@media(max-width:680px){.sidebar{position:fixed;width:64px;padding:15px 8px}.brand div:not(.brand-mark),.side-label,.nav:not(.active)::after,.nav{font-size:0}.nav{justify-content:center}.nav svg{font-size:16px}.teacher>div:nth-child(2),.teacher button{display:none}.main{margin-left:64px}.topbar{padding:0 12px}.searchbox{width:190px}.searchbox kbd{display:none}.stats{grid-template-columns:1fr 1fr}.hero h1{font-size:40px}.hero-meta{display:none}.page-heading{align-items:flex-start;gap:10px}.page-heading h1{font-size:30px}.table-card{overflow:auto}.sql-buttons{grid-template-columns:1fr}.theme-options{grid-template-columns:1fr}}
