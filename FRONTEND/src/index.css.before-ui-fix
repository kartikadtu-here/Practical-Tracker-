@import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap");

:root {
  font-family: "Manrope", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color-scheme: dark;
  --bg: #0b0f0b;
  --surface: #111711;
  --surface-2: #151b15;
  --surface-3: #1b221a;
  --text: #f2f5ef;
  --muted: #9da79a;
  --soft: #6f786d;
  --border: rgba(210, 225, 202, .12);
  --border-strong: rgba(210, 225, 202, .2);
  --accent: #789d68;
  --accent-2: #91b77d;
  --accent-soft: rgba(120, 157, 104, .14);
  --gold: #d2b66f;
  --rose: #d98585;
  --blue: #83a8c4;
  --shadow: 0 24px 70px rgba(0,0,0,.25);
  --sidebar: 260px;
  --topbar: 76px;
}

:root[data-theme="light"] {
  color-scheme: light;
  --bg: #f3f5ef;
  --surface: #ffffff;
  --surface-2: #f7f8f4;
  --surface-3: #edf0e9;
  --text: #1d241b;
  --muted: #687166;
  --soft: #90998e;
  --border: #e0e5dc;
  --border-strong: #cfd7ca;
  --accent: #5e8050;
  --accent-2: #4d6e41;
  --accent-soft: #e9f0e4;
  --gold: #9f8246;
  --rose: #a96060;
  --blue: #557f9e;
  --shadow: 0 24px 70px rgba(50, 64, 42, .08);
}

* { box-sizing: border-box; }

html, body, #root {
  min-height: 100%;
  margin: 0;
}

body {
  min-width: 320px;
  background:
    radial-gradient(circle at 78% 4%, var(--accent-soft), transparent 25rem),
    var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.5;
}

button, input, textarea, select { font: inherit; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: .55; }
input, textarea, select { color: var(--text); }
h1,h2,h3,p { margin: 0; }

.app-shell { min-height: 100vh; display: flex; }

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: var(--sidebar);
  display: flex;
  flex-direction: column;
  background: color-mix(in srgb, var(--surface) 94%, transparent);
  border-right: 1px solid var(--border);
  z-index: 50;
  backdrop-filter: blur(20px);
}

.sidebar-top { padding: 24px 20px 18px; display:flex; align-items:center; justify-content:space-between; }
.brand, .auth-brand { display:flex; align-items:center; gap:11px; }
.brand-mark {
  width: 38px; height: 38px; border-radius: 12px;
  display:grid; place-items:center;
  background: var(--accent-soft); color: var(--accent-2);
  border:1px solid var(--border);
}
.brand-mark.large { width:44px; height:44px; border-radius:14px; }
.brand strong, .auth-brand strong { display:block; font-size:14px; letter-spacing:-.02em; }
.brand span, .auth-brand span { display:block; margin-top:2px; color:var(--soft); font-size:11px; }

.sidebar-scroll { flex:1; overflow:auto; padding:8px 12px; }
.nav-group { margin-bottom:24px; }
.nav-label, .eyebrow {
  color: var(--soft);
  font-size:10px;
  font-weight:800;
  letter-spacing:.13em;
  text-transform:uppercase;
}
.nav-label { padding:0 10px 8px; }

.nav-item {
  width:100%; border:0; background:transparent; color:var(--muted);
  display:flex; align-items:center; gap:11px;
  padding:11px 12px; border-radius:11px;
  text-align:left; font-size:13px; font-weight:600;
  transition:.18s ease;
}
.nav-item:hover { background:var(--surface-2); color:var(--text); }
.nav-item.active { background:var(--accent-soft); color:var(--accent-2); box-shadow:inset 0 0 0 1px var(--border); }
.nav-item svg { flex:none; }
.sidebar-bottom { padding:12px; border-top:1px solid var(--border); }
.logout-nav { color:var(--muted); }
.profile-card {
  margin-top:10px; padding:10px; display:flex; align-items:center; gap:10px;
  border:1px solid var(--border); border-radius:13px; background:var(--surface-2);
}
.avatar { width:36px; height:36px; border-radius:50%; display:grid; place-items:center; flex:none; background:var(--accent-soft); color:var(--accent-2); font-size:11px; font-weight:800; }
.avatar.small { width:30px; height:30px; font-size:10px; }
.avatar.large { width:48px; height:48px; font-size:13px; }
.profile-copy { min-width:0; }
.profile-copy strong, .profile-copy span { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.profile-copy strong { font-size:11px; }
.profile-copy span { color:var(--soft); font-size:10px; margin-top:2px; }

.main-shell { width:100%; margin-left:var(--sidebar); min-width:0; }
.topbar {
  height:var(--topbar); position:sticky; top:0; z-index:30;
  display:flex; align-items:center; justify-content:space-between;
  padding:0 34px; background:color-mix(in srgb, var(--bg) 88%, transparent);
  border-bottom:1px solid var(--border); backdrop-filter:blur(18px);
}
.topbar-left { display:flex; align-items:center; gap:14px; }
.breadcrumb { color:var(--soft); text-transform:capitalize; font-size:10px; margin-bottom:2px; }
.topbar h2 { font-size:18px; letter-spacing:-.03em; }
.topbar-actions { display:flex; align-items:center; gap:10px; }
.connection-pill, .theme-toggle, .count-chip {
  border:1px solid var(--border); background:var(--surface); color:var(--muted);
  border-radius:999px; padding:8px 11px; display:flex; align-items:center; gap:7px; font-size:11px; font-weight:700;
}
.theme-toggle { border-radius:10px; }
.status-dot { width:7px; height:7px; border-radius:50%; background:var(--accent-2); box-shadow:0 0 0 4px var(--accent-soft); }
.page-content { width:min(1240px, calc(100% - 64px)); margin:0 auto; padding:42px 0 70px; }

.page-header { display:flex; align-items:flex-end; justify-content:space-between; gap:28px; margin-bottom:28px; }
.page-header h1 { margin-top:7px; font-size:clamp(30px, 4vw, 48px); line-height:1.05; letter-spacing:-.055em; }
.page-header h1 em { color:var(--accent-2); font-style:normal; }
.page-header p { max-width:720px; color:var(--muted); margin-top:13px; font-size:14px; }

.primary-btn, .secondary-btn, .text-btn, .icon-btn {
  border:1px solid var(--border); display:inline-flex; align-items:center; justify-content:center; gap:8px;
  transition:.18s ease;
}
.primary-btn {
  background:var(--accent); color:white; border-color:transparent; border-radius:11px; padding:11px 15px; font-weight:800; font-size:12px;
}
.primary-btn:hover { background:var(--accent-2); transform:translateY(-1px); }
.secondary-btn {
  background:var(--surface); color:var(--text); border-radius:11px; padding:10px 13px; font-weight:700; font-size:12px;
}
.secondary-btn:hover { border-color:var(--border-strong); background:var(--surface-2); }
.text-btn { background:transparent; border:0; color:var(--accent-2); font-size:11px; font-weight:800; }
.icon-btn { width:34px; height:34px; padding:0; border-radius:9px; background:transparent; color:var(--muted); }
.icon-btn:hover { background:var(--surface-2); color:var(--text); }
.icon-btn.danger:hover { color:var(--rose); }
.full { width:100%; }

.stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:14px; }
.stat-card, .panel {
  border:1px solid var(--border); background:linear-gradient(145deg,var(--surface),var(--surface-2));
  box-shadow:var(--shadow); border-radius:18px;
}
.stat-card { padding:20px; position:relative; overflow:hidden; min-height:148px; }
.stat-card::after { content:""; position:absolute; width:100px; height:100px; right:-40px; bottom:-45px; border-radius:50%; background:var(--accent-soft); }
.stat-icon { width:35px; height:35px; display:grid; place-items:center; border-radius:10px; color:var(--accent-2); background:var(--accent-soft); margin-bottom:17px; }
.stat-label { color:var(--muted); font-size:11px; font-weight:700; }
.stat-card strong { display:block; font-size:30px; line-height:1; letter-spacing:-.04em; margin-top:5px; }
.stat-card > span { display:block; color:var(--soft); font-size:10px; margin-top:8px; }
.stat-card.gold .stat-icon { color:var(--gold); background:color-mix(in srgb,var(--gold) 14%,transparent); }
.stat-card.blue .stat-icon { color:var(--blue); background:color-mix(in srgb,var(--blue) 14%,transparent); }

.dashboard-grid { display:grid; grid-template-columns:1.55fr 1fr; gap:14px; margin-bottom:14px; }
.panel { padding:22px; }
.hero-panel { min-height:300px; }
.quick-panel { padding:0; overflow:hidden; }
.panel-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:22px; }
.panel-head h3 { margin-top:4px; font-size:17px; letter-spacing:-.03em; }
.panel-head p { color:var(--muted); font-size:12px; margin-top:4px; }
.hero-chip { display:flex; align-items:center; gap:6px; padding:7px 9px; border:1px solid var(--border); border-radius:999px; color:var(--accent-2); font-size:10px; font-weight:800; }
.hero-progress { margin-top:55px; display:flex; align-items:baseline; gap:8px; }
.hero-progress strong { font-size:56px; letter-spacing:-.06em; line-height:1; }
.hero-progress span { color:var(--muted); font-size:11px; }
.progress-track, .mini-progress { height:8px; background:var(--surface-3); border-radius:99px; overflow:hidden; }
.progress-track { margin-top:18px; }
.progress-track div, .mini-progress div { height:100%; background:linear-gradient(90deg,var(--accent),var(--accent-2)); border-radius:inherit; transition:width .4s ease; }
.hero-footer { display:flex; justify-content:space-between; margin-top:12px; color:var(--soft); font-size:10px; }
.hero-footer b { color:var(--text); }

.quick-panel .panel-head { padding:22px 22px 17px; margin:0; border-bottom:1px solid var(--border); }
.quick-action { width:100%; border:0; border-bottom:1px solid var(--border); background:transparent; color:var(--text); display:grid; grid-template-columns:36px 1fr auto; align-items:center; gap:12px; text-align:left; padding:17px 22px; }
.quick-action:hover { background:var(--surface-2); }
.quick-icon { width:34px; height:34px; border-radius:10px; display:grid; place-items:center; color:var(--accent-2); background:var(--accent-soft); }
.quick-action strong, .quick-action span { display:block; }
.quick-action strong { font-size:12px; }
.quick-action span { color:var(--soft); font-size:10px; margin-top:2px; }

.progress-list { display:grid; gap:18px; }
.progress-row { display:grid; grid-template-columns:minmax(220px,1fr) 55px minmax(160px,.9fr); gap:18px; align-items:center; }
.progress-title { display:flex; align-items:center; gap:11px; }
.progress-title strong, .progress-title span { display:block; }
.progress-title strong { font-size:12px; }
.progress-title span { color:var(--soft); font-size:10px; margin-top:2px; }
.number-badge { width:30px; height:30px; border-radius:9px; display:grid; place-items:center; background:var(--accent-soft); color:var(--accent-2); font-size:11px; font-weight:800; flex:none; }
.number-badge.large { width:42px; height:42px; border-radius:12px; font-size:14px; }
.progress-value { font-size:12px; font-weight:800; text-align:right; }
.mini-progress { height:6px; }

.toolbar, .tracker-toolbar { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:16px; }
.search-box { display:flex; align-items:center; gap:9px; flex:1; min-width:240px; border:1px solid var(--border); background:var(--surface); border-radius:11px; padding:0 12px; color:var(--soft); }
.search-box input { width:100%; border:0; outline:0; background:transparent; padding:11px 0; color:var(--text); font-size:12px; }
.data-table-wrap { overflow-x:auto; }
.data-table { width:100%; border-collapse:collapse; min-width:650px; }
.data-table th { padding:11px 13px; color:var(--soft); text-align:left; font-size:9px; text-transform:uppercase; letter-spacing:.1em; border-bottom:1px solid var(--border); }
.data-table td { padding:13px; border-bottom:1px solid var(--border); font-size:12px; vertical-align:middle; }
.data-table tbody tr:hover { background:var(--surface-2); }
.student-cell { display:flex; align-items:center; gap:10px; }
.muted { color:var(--muted); }
.roll-pill { display:inline-flex; padding:5px 8px; border-radius:7px; background:var(--surface-3); font-family:"DM Mono",monospace; color:var(--muted); font-size:10px; }
.status-pill { display:inline-flex; align-items:center; gap:5px; padding:5px 8px; border-radius:999px; font-size:9px; font-weight:800; }
.status-pill.success { color:var(--accent-2); background:var(--accent-soft); }
.status-pill.pending { color:var(--gold); background:color-mix(in srgb,var(--gold) 13%,transparent); }
.staged-row { background:color-mix(in srgb,var(--accent) 5%,transparent); }
.staged-label { margin-left:7px; color:var(--gold); font-size:9px; }
.toggle { border:1px solid var(--border); background:var(--surface-2); color:var(--muted); border-radius:999px; padding:7px 10px; font-size:10px; font-weight:800; display:inline-flex; align-items:center; gap:7px; }
.toggle span { width:7px; height:7px; border-radius:50%; background:var(--soft); }
.toggle.on { color:var(--accent-2); border-color:color-mix(in srgb,var(--accent) 40%,var(--border)); background:var(--accent-soft); }
.toggle.on span { background:var(--accent-2); }

.tracker-toolbar { padding:14px; border:1px solid var(--border); border-radius:14px; background:var(--surface-2); }
.select-field { position:relative; min-width:300px; }
.select-field span { display:block; color:var(--soft); font-size:9px; font-weight:800; text-transform:uppercase; letter-spacing:.1em; margin:0 0 5px 2px; }
.select-field select { appearance:none; width:100%; border:1px solid var(--border); background:var(--surface); border-radius:10px; padding:10px 34px 10px 11px; outline:0; }
.select-field svg { position:absolute; right:11px; bottom:11px; pointer-events:none; color:var(--soft); }
.save-message { font-size:11px; font-weight:700; }
.save-message.success { color:var(--accent-2); }
.save-message.error { color:var(--rose); }

.two-column, .settings-grid { display:grid; grid-template-columns:1fr 1.2fr; gap:14px; }
.stack-form { display:grid; gap:14px; }
.stack-form label, .auth-form label { display:grid; gap:6px; }
.stack-form label > span, .auth-form label > span { color:var(--muted); font-size:11px; font-weight:700; }
.stack-form input, .stack-form textarea, .auth-form input {
  width:100%; border:1px solid var(--border); background:var(--surface-2); color:var(--text); outline:0; border-radius:10px; padding:11px 12px;
}
.stack-form input:focus, .stack-form textarea:focus, .auth-form input:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
.stack-form textarea { resize:vertical; }
.practical-list { display:grid; gap:8px; }
.practical-item { display:grid; grid-template-columns:42px 1fr auto; align-items:center; gap:12px; padding:12px; border:1px solid var(--border); border-radius:12px; }
.practical-item strong, .practical-item span { display:block; }
.practical-item strong { font-size:12px; }
.practical-item > div:nth-child(2) span { color:var(--soft); font-size:10px; margin-top:3px; }

.ocr-layout { display:grid; grid-template-columns:1fr 1.2fr; gap:14px; }
.dropzone { border:1px dashed var(--border-strong); border-radius:15px; min-height:250px; display:grid; place-items:center; align-content:center; text-align:center; padding:25px; background:var(--surface-2); cursor:pointer; }
.dropzone:hover { border-color:var(--accent); background:var(--accent-soft); }
.upload-icon { width:50px; height:50px; border-radius:14px; display:grid; place-items:center; color:var(--accent-2); background:var(--accent-soft); margin-bottom:12px; }
.dropzone h3 { font-size:15px; }
.dropzone p { color:var(--soft); font-size:11px; margin:5px 0 14px; }
.preview-wrap { margin-top:14px; border:1px solid var(--border); border-radius:13px; overflow:hidden; background:var(--surface-3); max-height:300px; }
.preview-wrap img { display:block; width:100%; max-height:300px; object-fit:contain; }
.ocr-actions { display:flex; gap:8px; margin-top:14px; }
.review-list { display:grid; gap:8px; max-height:430px; overflow:auto; margin-bottom:14px; }
.review-row { display:grid; grid-template-columns:100px 1fr 34px; gap:8px; }
.review-row input { min-width:0; border:1px solid var(--border); background:var(--surface-2); color:var(--text); border-radius:9px; padding:9px 10px; outline:0; font-size:12px; }
.review-row input:focus { border-color:var(--accent); }

.timeline { display:grid; }
.timeline-item { display:grid; grid-template-columns:32px 1fr auto; gap:12px; padding:16px 0; border-bottom:1px solid var(--border); align-items:center; }
.timeline-dot { width:30px; height:30px; display:grid; place-items:center; border-radius:50%; background:var(--accent-soft); color:var(--accent-2); }
.timeline-content strong, .timeline-content span, .timeline-content small { display:block; }
.timeline-content strong { font-size:12px; }
.timeline-content span { color:var(--muted); font-size:10px; margin-top:2px; }
.timeline-content small { color:var(--soft); font-size:9px; margin-top:4px; }
.timeline-change { color:var(--accent-2); font-family:"DM Mono",monospace; font-size:10px; }

.export-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
.export-card { min-height:245px; display:flex; flex-direction:column; align-items:flex-start; }
.export-icon { width:45px; height:45px; border-radius:13px; display:grid; place-items:center; color:var(--accent-2); background:var(--accent-soft); margin-bottom:25px; }
.export-card h3 { font-size:17px; }
.export-card p { color:var(--muted); font-size:11px; margin:7px 0 auto; max-width:250px; }
.export-message { margin-top:14px; }

.sql-layout { display:grid; grid-template-columns:340px 1fr; gap:14px; }
.sql-list { padding:12px; }
.sql-list > .eyebrow { padding:8px 10px 10px; }
.sql-item { width:100%; border:0; background:transparent; color:var(--muted); padding:13px 10px; display:grid; grid-template-columns:28px 1fr auto; gap:10px; align-items:center; text-align:left; border-radius:11px; }
.sql-item:hover, .sql-item.active { background:var(--accent-soft); color:var(--text); }
.sql-item strong, .sql-item small { display:block; }
.sql-item strong { font-size:11px; }
.sql-item small { color:var(--soft); font-size:9px; margin-top:3px; }
.sql-editor { padding:0; overflow:hidden; }
.editor-top { display:flex; justify-content:space-between; padding:13px 17px; border-bottom:1px solid var(--border); color:var(--soft); font-size:10px; font-family:"DM Mono",monospace; }
.editor-top span:first-child { display:flex; align-items:center; gap:8px; }
.sql-editor pre { margin:0; padding:25px; min-height:270px; background:var(--surface-2); color:var(--accent-2); font:12px/1.8 "DM Mono",monospace; white-space:pre-wrap; }
.query-result { margin:14px; padding:12px; display:flex; gap:9px; align-items:flex-start; border:1px solid var(--border); border-radius:10px; color:var(--muted); font-size:11px; }
.query-result svg { color:var(--accent-2); flex:none; }

.theme-options { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.theme-options button { border:1px solid var(--border); background:var(--surface-2); color:var(--muted); text-align:left; padding:17px; border-radius:12px; }
.theme-options button:hover, .theme-options button.selected { border-color:var(--accent); background:var(--accent-soft); color:var(--text); }
.theme-options strong, .theme-options span { display:block; }
.theme-options strong { margin-top:12px; font-size:12px; }
.theme-options span { margin-top:3px; color:var(--soft); font-size:10px; }
.account-detail { display:flex; align-items:center; gap:12px; padding:14px; border:1px solid var(--border); border-radius:12px; background:var(--surface-2); }
.account-detail strong, .account-detail span { display:block; }
.account-detail span { color:var(--soft); font-size:10px; margin-top:2px; }
.connection-card { margin-top:12px; display:grid; grid-template-columns:8px 1fr auto; gap:10px; align-items:center; padding:12px; border:1px solid var(--border); border-radius:12px; }
.connection-card > .status-dot { grid-column:1; }
.connection-card strong, .connection-card span { display:block; }
.connection-card strong { font-size:11px; }
.connection-card div span { color:var(--soft); font-size:9px; margin-top:2px; }

.empty-state { min-height:240px; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:30px; }
.empty-icon { width:48px; height:48px; display:grid; place-items:center; border-radius:14px; color:var(--accent-2); background:var(--accent-soft); margin-bottom:12px; }
.empty-state h3 { font-size:15px; }
.empty-state p { max-width:360px; color:var(--soft); font-size:11px; margin:5px 0 15px; }
.loading-state { min-height:220px; display:flex; align-items:center; justify-content:center; gap:10px; color:var(--muted); font-size:12px; }
.form-error, .success-banner { display:flex; align-items:center; gap:8px; padding:10px 12px; border-radius:10px; font-size:11px; }
.form-error { color:var(--rose); background:color-mix(in srgb,var(--rose) 10%,transparent); border:1px solid color-mix(in srgb,var(--rose) 25%,transparent); }
.success-banner { color:var(--accent-2); background:var(--accent-soft); border:1px solid color-mix(in srgb,var(--accent) 25%,transparent); margin-top:12px; }

.boot-screen { min-height:100vh; display:grid; place-items:center; align-content:center; gap:12px; color:var(--muted); font-size:12px; background:var(--bg); }

.auth-shell { min-height:100vh; display:grid; place-items:center; position:relative; overflow:hidden; padding:30px; background:radial-gradient(circle at 50% 20%, var(--accent-soft), transparent 35rem), var(--bg); }
.auth-card { width:min(440px,100%); position:relative; z-index:2; padding:34px; border:1px solid var(--border); border-radius:24px; background:color-mix(in srgb,var(--surface) 92%,transparent); box-shadow:var(--shadow); backdrop-filter:blur(20px); }
.auth-heading { margin:48px 0 28px; }
.auth-heading h1 { font-size:42px; letter-spacing:-.055em; line-height:1; margin-top:8px; }
.auth-heading p { color:var(--muted); font-size:12px; line-height:1.7; margin-top:12px; max-width:340px; }
.auth-form { display:grid; gap:15px; }
.input-wrap { position:relative; display:flex; align-items:center; border:1px solid var(--border); background:var(--surface-2); border-radius:11px; color:var(--soft); padding-left:11px; }
.input-wrap:focus-within { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
.input-wrap input { border:0; background:transparent; outline:0; padding:12px 10px; min-width:0; flex:1; }
.input-action { border:0; background:transparent; color:var(--accent-2); font-size:10px; font-weight:800; padding:8px 11px; }
.auth-submit { width:100%; margin-top:5px; padding:13px; }
.auth-note { display:flex; align-items:center; gap:7px; color:var(--soft); font-size:10px; margin-top:15px; }
.auth-note svg { color:var(--accent-2); }
.auth-footer { position:absolute; bottom:20px; color:var(--soft); font-size:10px; }
.auth-orbit { position:absolute; border:1px solid var(--border); border-radius:50%; pointer-events:none; }
.orbit-one { width:620px; height:620px; top:-280px; right:-160px; }
.orbit-two { width:480px; height:480px; bottom:-300px; left:-180px; }

.mobile-menu, .mobile-close, .mobile-backdrop { display:none; }

.spin { animation:spin .8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

@media (max-width:1100px) {
  :root { --sidebar:230px; }
  .page-content { width:min(100% - 40px,1100px); }
  .stats-grid { grid-template-columns:repeat(2,1fr); }
  .dashboard-grid, .ocr-layout, .two-column, .settings-grid { grid-template-columns:1fr; }
  .export-grid { grid-template-columns:1fr 1fr; }
}

@media (max-width:760px) {
  :root { --sidebar:0px; --topbar:66px; }
  .sidebar { width:280px; transform:translateX(-100%); transition:transform .2s ease; box-shadow:var(--shadow); }
  .sidebar.mobile-open { transform:translateX(0); }
  .mobile-close, .mobile-menu { display:grid; }
  .mobile-backdrop { display:block; position:fixed; inset:0; z-index:40; border:0; background:rgba(0,0,0,.45); }
  .main-shell { margin-left:0; }
  .topbar { padding:0 18px; }
  .connection-pill { display:none; }
  .page-content { width:calc(100% - 28px); padding-top:28px; }
  .page-header { align-items:flex-start; flex-direction:column; gap:16px; }
  .page-header h1 { font-size:34px; }
  .progress-row { grid-template-columns:1fr 50px; }
  .progress-row .mini-progress { grid-column:1 / -1; }
  .sql-layout { grid-template-columns:1fr; }
  .export-grid { grid-template-columns:1fr; }
}

@media (max-width:520px) {
  body { font-size:13px; }
  .stats-grid { grid-template-columns:1fr 1fr; gap:9px; }
  .stat-card { padding:14px; min-height:130px; }
  .stat-card strong { font-size:25px; }
  .panel { padding:16px; border-radius:14px; }
  .topbar-actions .theme-toggle span { display:none; }
  .theme-toggle { padding:9px; }
  .select-field { min-width:100%; }
  .search-box { min-width:100%; }
  .auth-shell { padding:16px; }
  .auth-card { padding:25px 20px; border-radius:18px; }
  .auth-heading { margin-top:35px; }
  .auth-heading h1 { font-size:36px; }
  .theme-options { grid-template-columns:1fr; }
}

