function TrackerPage() {
  const [students, setStudents] = useState<Student[]>([]);
  const [practicals, setPracticals] = useState<Practical[]>([]);
  const [selected, setSelected] = useState("");
  const [submissions, setSubmissions] = useState<Submission[]>([]);
  const [changes, setChanges] = useState<Record<string, boolean>>({});
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");

  async function loadBase() {
    setLoading(true);
    try {
      const [studentResult, practicalResult] = await Promise.all([
        api<any>("/api/students"),
        api<any>("/api/practicals"),
      ]);
      const nextStudents = unwrap<Student[]>(studentResult, []);
      const nextPracticals = unwrap<Practical[]>(practicalResult, []);
      setStudents(nextStudents);
      setPracticals(nextPracticals);
      if (!selected && nextPracticals[0]) setSelected(nextPracticals[0].id);
    } finally {
      setLoading(false);
    }
  }

  async function loadSubmissions(practicalId: string) {
    if (!practicalId) {
      setSubmissions([]);
      return;
    }
    try {
      const result = await api<any>(`/api/submissions?practicalId=${encodeURIComponent(practicalId)}`);
      setSubmissions(unwrap<Submission[]>(result, []));
      setChanges({});
      setMessage("");
    } catch {
      setSubmissions([]);
    }
  }

  useEffect(() => {
    void loadBase();
  }, []);

  useEffect(() => {
    if (selected) void loadSubmissions(selected);
  }, [selected]);

  const submissionMap = useMemo(
    () => new Map(submissions.map((item) => [item.studentId, bool(item.submitted)])),
    [submissions]
  );

  const filtered = students.filter((student) =>
    `${student.rollNumber} ${student.name}`.toLowerCase().includes(search.toLowerCase())
  );

  const stagedCount = Object.keys(changes).length;

  function toggle(studentId: string) {
    const current = changes[studentId] ?? submissionMap.get(studentId) ?? false;
    setChanges((previous) => ({ ...previous, [studentId]: !current }));
  }

  async function apply() {
    if (!selected || stagedCount === 0) return;
    setSaving(true);
    setMessage("");
    try {
      await api("/api/submissions/apply", {
        method: "POST",
        body: JSON.stringify({
          changes: Object.entries(changes).map(([studentId, submitted]) => ({
            studentId,
            practicalId: selected,
            submitted,
          })),
        }),
      });
      await loadSubmissions(selected);
      setMessage("Changes applied successfully.");
    } catch (err) {
      setMessage(err instanceof Error ? err.message : "Unable to apply changes.");
    } finally {
      setSaving(false);
    }
  }

  return (
    <>
      <PageHeader
        eyebrow="SUBMISSION TRACKER"
        title="Mark practical submissions"
        description="Changes stay staged in the browser until you press Apply changes. Student identity cannot be edited here."
        action={
          <button className="primary-btn" disabled={!stagedCount || saving} onClick={apply}>
            {saving ? <RefreshCw size={16} className="spin" /> : <Check size={16} />}
            {saving ? "Applying…" : `Apply changes${stagedCount ? ` · ${stagedCount}` : ""}`}
          </button>
        }
      />

      <div className="tracker-toolbar">
        <label className="select-field">
          <span>Practical</span>
          <select value={selected} onChange={(e) => setSelected(e.target.value)}>
            <option value="">Select practical</option>
            {practicals.map((item) => (
              <option key={item.id} value={item.id}>
                Practical {item.practicalNumber} · {item.title}
              </option>
            ))}
          </select>
          <ChevronDown size={15} />
        </label>

        <div className="search-box">
          <Search size={17} />
          <input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Find a student…" />
        </div>

        {message && <span className={`save-message ${message.includes("successfully") ? "success" : "error"}`}>{message}</span>}
      </div>

      <article className="panel tracker-panel">
        {!selected ? (
          <EmptyState icon={ClipboardCheck} title="Choose a practical" description="Select a practical above to start marking submissions." />
        ) : loading ? <Loading /> : (
          <div className="data-table-wrap">
            <table className="data-table tracker-table">
              <thead><tr><th>Roll</th><th>Student</th><th>Submission</th><th>Action</th></tr></thead>
              <tbody>
                {filtered.map((student) => {
                  const submitted = changes[student.id] ?? submissionMap.get(student.id) ?? false;
                  const staged = student.id in changes;
                  return (
                    <tr key={student.id} className={staged ? "staged-row" : ""}>
                      <td><span className="roll-pill">{student.rollNumber}</span></td>
                      <td><div className="student-cell"><div className="avatar small">{initials(student.name)}</div><strong>{student.name}</strong></div></td>
                      <td>
                        <span className={`status-pill ${submitted ? "success" : "pending"}`}>
                          {submitted ? <Check size={13} /> : <Activity size={13} />}
                          {submitted ? "Submitted" : "Pending"}
                        </span>
                        {staged && <span className="staged-label">unsaved</span>}
                      </td>
                      <td>
                        <button className={`toggle ${submitted ? "on" : ""}`} onClick={() => toggle(student.id)}>
                          <span />
                          {submitted ? "Submitted" : "Mark submitted"}
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </article>
    </>
  );
}

function PracticalsPage() {
