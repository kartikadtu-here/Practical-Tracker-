function OcrPage({ navigate }: { navigate: (page: Page) => void }) {
  const [file, setFile] = useState<File | null>(null);
  const [preview, setPreview] = useState("");
  const [students, setStudents] = useState<OcrStudent[]>([]);
  const [busy, setBusy] = useState(false);
  const [importing, setImporting] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  function choose(next: File | null) {
    setFile(next);
    setStudents([]);
    setError("");
    setMessage("");
    if (next) setPreview(URL.createObjectURL(next));
    else setPreview("");
  }

  async function runOcr() {
    if (!file) return;
    setBusy(true);
    setError("");
    setMessage("");
    try {
      const body = new FormData();
      body.append("file", file);
      const result = await api<any>("/api/ocr", { method: "POST", body });
      const extracted =
        result?.data?.students ||
        result?.students ||
        (Array.isArray(result?.data) ? result.data : []);
      setStudents(
        (extracted as any[]).map((item) => ({
          rollNumber: String(item.rollNumber ?? item.roll ?? ""),
          name: String(item.name ?? "").trim(),
        })).filter((item) => item.rollNumber && item.name)
      );
      setMessage("OCR complete. Review the extracted rows before importing.");
    } catch (err) {
      setError(err instanceof Error ? err.message : "OCR failed.");
    } finally {
      setBusy(false);
    }
  }

  async function confirmImport() {
    if (!students.length) return;
    setImporting(true);
    setError("");
    try {
      await api("/api/students/import", {
        method: "POST",
        body: JSON.stringify({ students }),
      });
      setMessage(`${students.length} students imported successfully.`);
      setStudents([]);
      setFile(null);
      setPreview("");
      navigate("students");
    } catch (err) {
      setError(err instanceof Error ? err.message : "Import failed.");
    } finally {
      setImporting(false);
    }
  }

  return (
    <>
      <PageHeader eyebrow="OCR IMPORT" title="Turn a student list into data" description="Upload an image, let OCR extract the rows, review the result and only then write it into D1." />
      <section className="ocr-layout">
        <article className="panel upload-panel">
          <div className="dropzone" onClick={() => document.getElementById("student-image")?.click()}>
            <div className="upload-icon"><Upload size={22} /></div>
            <h3>{file ? file.name : "Drop student list here"}</h3>
            <p>PNG or JPG · Review before import</p>
            <button type="button" className="secondary-btn">Choose image</button>
            <input id="student-image" type="file" accept="image/png,image/jpeg,image/webp" hidden onChange={(e) => choose(e.target.files?.[0] || null)} />
          </div>

          {preview && <div className="preview-wrap"><img src={preview} alt="Student list preview" /></div>}

          <div className="ocr-actions">
            <button className="primary-btn" disabled={!file || busy} onClick={runOcr}>
              {busy ? <><RefreshCw size={16} className="spin" /> Reading image…</> : <><Sparkles size={16} /> Extract students</>}
            </button>
            {file && <button className="secondary-btn" onClick={() => choose(null)}><X size={16} /> Clear</button>}
          </div>
          {error && <InlineError message={error} />}
          {message && <div className="success-banner"><CheckCircle2 size={16} /> {message}</div>}
        </article>

        <article className="panel">
          <div className="panel-head">
            <div><div className="eyebrow">REVIEW QUEUE</div><h3>Extracted students</h3></div>
            <span className="count-chip">{students.length}</span>
          </div>

          {students.length ? (
            <>
              <div className="review-list">
                {students.map((student, index) => (
                  <div className="review-row" key={`${student.rollNumber}-${index}`}>
                    <input value={student.rollNumber} onChange={(e) => setStudents((all) => all.map((x, i) => i === index ? { ...x, rollNumber: e.target.value } : x))} />
                    <input value={student.name} onChange={(e) => setStudents((all) => all.map((x, i) => i === index ? { ...x, name: e.target.value } : x))} />
                    <button className="icon-btn danger" onClick={() => setStudents((all) => all.filter((_, i) => i !== index))}><X size={15} /></button>
                  </div>
                ))}
              </div>
              <button className="primary-btn full" disabled={importing} onClick={confirmImport}>
                {importing ? "Importing…" : `Confirm import · ${students.length} students`}
              </button>
            </>
          ) : (
            <EmptyState icon={Table2} title="Nothing to review" description="Your OCR results will appear here before they are saved." />
          )}
        </article>
      </section>
    </>
  );
}

