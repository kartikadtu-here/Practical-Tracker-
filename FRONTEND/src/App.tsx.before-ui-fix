    try {
      const result = await api<any>("/api/practicals");
      setItems(unwrap<Practical[]>(result, []));
    } catch {
      setItems([]);
    }
  }

  useEffect(() => {
    void load();
  }, []);

  async function create(event: React.FormEvent) {
    event.preventDefault();
    setSaving(true);
